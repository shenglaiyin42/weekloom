{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekloom.dev/schemas/inbox-item.schema.json",
  "title": "Weekloom Inbox Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "notes", "status", "captured_at", "processed_at", "converted_to_type", "converted_to_id"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "notes": {"type": "string", "maxLength": 2000},
    "status": {"$ref": "common.schema.json#/$defs/inboxStatus"},
    "captured_at": {"$ref": "common.schema.json#/$defs/datetime"},
    "processed_at": {"type": ["string", "null"], "format": "date-time"},
    "converted_to_type": {"type": ["string", "null"], "enum": ["project", "action", "week", null]},
    "converted_to_id": {"type": ["string", "null"]}
  }
}
